{
  // 配置格式版本。升级时不要自行修改。
  "schemaVersion": 1,

  // 目标副屏。优先按名称匹配；名称为空时可使用 EDID vendor/model ID。
  "display": {
    "nameContains": "Portable Display",
    "vendorID": null,
    "modelID": null,
    // 面板与屏幕可见区域之间的留白，单位为 point。
    "padding": 10
  },

  "behavior": {
    // 启动时显示的页面 ID，必须对应 pages 中的一项。
    "initialPage": "overview",
    // 自动切页间隔；设为 0 关闭。鼠标位于面板时仍可滚轮切页。
    "autoRotateSeconds": 20
  },

  "appearance": {
    // Apple 推荐使用 system：英文采用 SF Pro，中文自动采用系统中文字体。
    // 可选：system、rounded、serif、monospaced。
    "lyricFontDesign": "system",
    // 只缩放歌词字号，推荐 1.0；允许范围 0.8–1.35。
    "lyricFontScale": 1.0
  },

  "lyrics": {
    // 关闭后不启动 media-control，也不访问歌词服务。
    "enabled": true,
    // null 时自动查找 Homebrew 标准路径。
    "mediaControlPath": null,
    // 当前内置 provider：netease。
    "provider": "netease"
  },

  // 新安装默认只有总览、歌词和本机状态。
  // 只有用户主动添加 httpJSON 页面和对应 source 时才访问外部 JSON。
  // kind 可选：overview、lyrics、httpJSON、localSystem。
  "pages": [
    { "id": "overview", "title": "Overview", "kind": "overview", "sourceID": null },
    { "id": "lyrics", "title": "Lyrics", "kind": "lyrics", "sourceID": null },
    { "id": "local", "title": "This Mac", "kind": "localSystem", "sourceID": null }
  ],

  // 通用只读 HTTPS JSON 数据源；默认留空，不会发起任何状态 API 请求。
  // 完整示例见 Examples/http-json-page.jsonc 和 README。
  "sources": [],

  // 本机信息页要显示的卷。路径不存在时显示“未挂载”。
  "volumes": [
    { "id": "system", "label": "System", "path": "/" }
  ]
}
