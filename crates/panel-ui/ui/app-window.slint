                VerticalLayout {
                    padding: 18px;
                    spacing: 8px;
                    Text { text: "CPU"; color: #aeb8c8; font-size: 14px; }
                    Text { text: "—"; color: #f4f7fb; font-size: 30px; font-weight: 700; }
                    Text { text: "Waiting for platform adapter"; color: #70a7ff; font-size: 13px; }
                }
            }

            Rectangle {
                background: #1b2230;
                border-radius: 18px;
                horizontal-stretch: 1;

                VerticalLayout {
                    padding: 18px;
                    spacing: 8px;
                    Text { text: "MEMORY"; color: #aeb8c8; font-size: 14px; }
                    Text { text: "—"; color: #f4f7fb; font-size: 30px; font-weight: 700; }
                    Text { text: "Cross-platform model ready"; color: #62d394; font-size: 13px; }
                }
            }

            Rectangle {
                background: #1b2230;
                border-radius: 18px;
                horizontal-stretch: 1;

                VerticalLayout {
                    padding: 18px;
                    spacing: 8px;
                    Text { text: "PLUGINS"; color: #aeb8c8; font-size: 14px; }
